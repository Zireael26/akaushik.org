# local agent/tooling config — .claude/* is blanket-ignored; the allowlist
# below tracks the bits that ARE project state and should travel with the repo.
# Rules, commands and project-authored skills stay committable; anything an
# attached agent toolchain plants (its own hooks, skills, settings) does not.
.claude/*
!.claude/rules/
!.claude/commands/
!.claude/primers/
!.claude/primers/*
!.claude/skills/
.claude/skills/*
!.claude/skills/process-gate-local/
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/config.sh
context-log.md

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Lighthouse CI local artefacts (lhci writes here; CI uploads via the action)
.lighthouseci/

# Vitest coverage reports
coverage/

# Codex / OMP parity — .agents and .codex are NOT under the .claude/* blanket,
# so each gets the same treatment: project state is allowlisted, everything an
# attached toolchain plants is ignored. `.claude/hooks/config.sh` and
# `.codex/hooks/config.sh` are the project-owned hook override surface.
.agents/*
!.agents/rules/
!.agents/commands/
!.agents/primers/
!.agents/primers/*
!.agents/skills/
.agents/skills/*
!.agents/skills/process-gate-local/
.codex/*
!.codex/hooks/
.codex/hooks/*
!.codex/hooks/config.sh
.omp/

# agent session state — project-owned section, not a generated fragment.
# Per-machine, per-session files an attached agent harness writes into the
# checkout. Ignoring them keeps an attached working copy clean. The `.codex/`
# and `.omp/` equivalents are already covered by the blanket rules above.
.claude/settings.local.json
.claude/session-autonomy
.claude/session-surgical
.claude/.reread-state/
.claude/.review-done-*
.claude/.fail-counter
.claude/screenshots/
.claude/worktrees/
.trellis/

# OpenNext / Cloudflare build output
.open-next/
.wrangler/
cloudflare-env.d.ts

proxy.ts.cf-parked
proxy.test.ts.cf-parked

# Compiled MDX bodies — regenerated by prebuild/pretypecheck.
lib/mdx/generated/
