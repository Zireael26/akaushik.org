{
  "name": "akaushik-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.x",
    "pnpm": "11.9.x"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "predev": "sh scripts/local-infra-preflight.sh",
    "dev": "next dev --turbo -p 3100",
    "prebuild": "tsx scripts/build-agent-skills-index.ts",
    "build": "next build",
    "prestart": "sh scripts/local-infra-preflight.sh",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "typecheck:compare": "tsc6 --noEmit && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "process:check": "node scripts/process-gate.mjs",
    "production:check": "node scripts/check-production.mjs",
    "stats:fetch": "node scripts/fetch-github-stats.mjs",
    "render:work": "node scripts/hyperframes/render-all.mjs",
    "render:posters": "node scripts/hyperframes/generate-posters.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "ci:serve": "pnpm build && pnpm start"
  },
  "dependencies": {
    "next": "16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "postcss": "8.5.13",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "0.7.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10",
    "wait-on": "^9.0.10",
    "yaml": "2.9.0"
  }
}
