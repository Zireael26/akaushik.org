{
  "name": "learn-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "course": "node scripts/build-course.mjs",
    "predev": "node scripts/build-course.mjs",
    "dev": "next dev -p 3300",
    "prebuild": "node scripts/build-course.mjs",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "pretypecheck": "node scripts/build-course.mjs",
