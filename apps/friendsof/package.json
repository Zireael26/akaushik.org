{
  "name": "friendsof-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx test/qualification.test.ts",
    "test:contracts": "tsx --conditions=react-server --test test/data-contract.test.ts test/dal-domain.test.ts test/question-register.test.ts test/source-link-resolver.test.ts",
    "deploy:production": "wrangler deploy --env production",
    "types:worker": "wrangler types worker/portal-env.d.ts",
    "test:markdown": "tsx --conditions=react-server --test test/markdown.test.ts test/importer.test.ts test/imports-rollback.test.ts"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "better-auth": "1.7.3",
    "@better-auth/kysely-adapter": "1.7.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "tsx": "4.23.0",
    "typescript": "6.0.2",
    "wrangler": "^4.129.1"
  }
}
