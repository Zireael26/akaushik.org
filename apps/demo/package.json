  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.0",
    "typescript": "6.0.2",
    "wrangler": "^4.129.1"
