#!/usr/bin/env sh
# akaushik.org pre-commit: run the project's own process gate over staged changes.
# See docs/adr/0002-process-gate-policy.md; CI re-runs the same gate against main.
set -e

command -v node >/dev/null 2>&1 || { echo "[pre-commit] node unavailable; skipping"; exit 0; }

has_script() {
  node -e "const p=require('./package.json');process.exit((p.scripts||{})['$1']?0:1)" 2>/dev/null
}
run_script() {
  if   [ -f pnpm-lock.yaml ];                 then pnpm run "$1"
  elif [ -f bun.lock ] || [ -f bun.lockb ];   then bun run "$1"
  elif [ -f yarn.lock ];                      then yarn run "$1"
  else                                             npm run "$1"
  fi
}

if has_script process:check; then run_script process:check; fi
